      <AdditionalOptions>%(AdditionalOptions) /analyze-</AdditionalOptions>
      <DisableSpecificWarnings>4005;4013;4028;4031;4047;4090;4133;4164;4244;4267;4334</DisableSpecificWarnings>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PreprocessorDefinitions>
        WIN32;
        WINDOWS;
        _WIN32_WINNT=0x501;
        WIN32_LEAN_AND_MEAN;
        _LIB;
        DSO_WIN32;
        ENGINESDIR="THIS_SHOULD_NOT_BE_USED";
        L_ENDIAN;
        OPENSSL_THREADS;
        OPENSSL_NO_DYNAMIC_ENGINE;
        OPENSSL_PIC;
        OPENSSL_SYS_WIN32;
        OPENSSL_BUILDING_OPENSSL;
        OPENSSLDIR="THIS_SHOULD_NOT_BE_USED";
        UNICODE;
        _CRT_SECURE_NO_DEPRECATE;
        _UNICODE;
        _WINSOCK_DEPRECATED_NO_WARNINGS;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <WarningLevel>Level3</WarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>
